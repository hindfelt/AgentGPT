# Deployment Environment:
NODE_ENV=development

# Next Auth config:
# Generate a secret with `openssl rand -base64 32`, or visit https://generate-secret.vercel.app/
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000

# Prisma
DATABASE_URL=file:./db.sqlite

# External APIs:
OPENAI_API_KEY=changeme

# Daily Email Summary (Cron)
# Microsoft Entra app with Mail.Read + Mail.Send application permissions
MS_GRAPH_TENANT_ID=changeme
MS_GRAPH_CLIENT_ID=changeme
MS_GRAPH_CLIENT_SECRET=changeme
# The mailbox to read and send the summary to
SUMMARY_EMAIL_ADDRESS=you@example.com
# Random secret used by Vercel Cron to authenticate the cron endpoint
# Generate with: openssl rand -base64 32
CRON_SECRET=changeme
